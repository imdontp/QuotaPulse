/** Notification delivery control over compiled web, owned SQLite and real HTTP. */
import assert from 'node:assert/strict';
import {createHash} from 'node:crypto';
import {mkdirSync,readFileSync,writeFileSync} from 'node:fs';
import {resolve} from 'node:path';
import {fileURLToPath} from 'node:url';
import {chromium,type Page} from 'playwright';
import {openDb} from '../packages/daemon/src/db/index.js';
import {buildServer} from '../packages/daemon/src/api/server.js';
import {Scheduler} from '../packages/daemon/src/ingest/scheduler.js';
import {installBrowserFixedDate} from './browser-fixed-date.mjs';
import {en} from '../packages/web/src/i18n/en.ts';
import {th} from '../packages/web/src/i18n/th.ts';

const root=fileURLToPath(new URL('..',import.meta.url)),output=resolve(root,'screens/alert-notification-switch');mkdirSync(output,{recursive:true});
const now=Date.parse('2025-05-17T13:42:00Z'),token='owned-notification-switch',base='http://127.0.0.1:7841';
const db=openDb(':memory:');db.exec("INSERT INTO source(id,harness,profile,root_path,display_name,detected_at) VALUES(1,'codex','qa','/synthetic/nonexistent','Notification fixture',0);INSERT INTO session(id,source_id,native_session_id,project) VALUES(1,1,'notification-fixture','Notification project');INSERT INTO usage_event(source_id,session_id,dedup_key,ts,model,provider,total_tokens,call_count,cost_usd,cost_source) VALUES(1,1,'one',1,'Notification model','openai',100,1,.01,'computed')");
const webRoot=resolve(root,'packages/web/dist'),productionIndexSha256=createHash('sha256').update(readFileSync(resolve(webRoot,'index.html'))).digest('hex');
const app=buildServer(db,new Scheduler(db,[]),{token,port:7841,webRoot});
const notification=()=>db.prepare('SELECT * FROM notification_setting WHERE id=1').get() as any;
const collection=()=>({sources:db.prepare('SELECT * FROM source ORDER BY id').all(),usage:db.prepare('SELECT * FROM usage_event ORDER BY id').all(),cursors:db.prepare('SELECT * FROM ingest_state ORDER BY source_id,target_key').all()});
let browser:Awaited<ReturnType<typeof chromium.launch>>|undefined,current:Page|undefined;const cases:unknown[]=[],errors:string[]=[],external:string[]=[],writes:any[]=[];
const gate=()=>{let release!:()=>void;const promise=new Promise<void>(resolve=>{release=resolve});return{promise,release}};
try{
 await app.listen({host:'127.0.0.1',port:7841});browser=await chromium.launch({channel:'chrome',headless:true});
 for(const lang of ['en','th']as const)for(const theme of ['dark','light'])for(const width of [390,900,1280,1672])for(const reducedMotion of ['reduce','no-preference']as const){
  db.prepare('INSERT OR REPLACE INTO notification_setting(id,enabled,snooze_until,quiet_start,quiet_end,updated_at) VALUES(1,0,4102444800000,1320,420,0)').run();
  const context=await browser.newContext({viewport:{width,height:941},reducedMotion}),page=await context.newPage();current=page;const messages=lang==='th'?th:en,name=`${lang}-${theme}-${width}-${reducedMotion}`;
  page.on('pageerror',e=>errors.push(e.message));page.on('request',r=>{if(new URL(r.url()).origin!==base)external.push(r.url());if(r.method()!=='GET')writes.push({method:r.method(),path:new URL(r.url()).pathname,body:r.postDataJSON()});});
  await page.addInitScript(({lang,theme,token})=>{(window as any).__QUOTAPULSE_TOKEN__=token;localStorage.setItem('quotapulse-prefs',JSON.stringify({lang,currency:'USD',rate:1,hiddenSubscriptions:[]}));localStorage.setItem('quotapulse-theme',theme);},{lang,theme,token});await installBrowserFixedDate(page,now);
  const initial=gate(),put=gate();let readFail=lang==='th'&&theme==='light'&&width===390&&reducedMotion==='reduce',putMode:'hold'|'fail'|'pass'='hold',putCount=0;
  await page.route('**/api/notification-settings',async route=>{if(route.request().method()==='GET'){await initial.promise;if(readFail)return route.fulfill({status:503,contentType:'application/json',body:'{"error":"owned initial failure"}'});return route.continue();}putCount++;if(putMode==='hold')await put.promise;if(putMode==='fail')return route.fulfill({status:503,contentType:'application/json',body:'{"error":"owned update failure"}'});return route.continue();});
  await page.goto(base+'/#alerts',{waitUntil:'domcontentloaded'});const control=page.getByRole('checkbox',{name:messages['redesign.alertNotifications'],exact:true}),card=page.locator('.qp-alert-notifications');await control.waitFor();assert.equal(await control.isDisabled(),true);assert.equal(await card.locator('small').innerText(),messages['redesign.unknownValue']);const describedBy=await control.getAttribute('aria-describedby');assert.ok(describedBy);assert.ok((await page.evaluate(id=>document.getElementById(id)?.textContent,describedBy))?.includes(messages['redesign.alertCollectionNote']));
  initial.release();const initialFailure=readFail;if(readFail){await page.waitForFunction(value=>document.querySelector('.qp-alert-notification-switch')?.getAttribute('title')===value,messages['redesign.unknownValue']);assert.equal(await control.isDisabled(),true);readFail=false;await page.getByRole('button',{name:messages['app.refreshNow'],exact:true}).click();}
  await page.waitForFunction(()=>!(document.querySelector('.qp-alert-notification-switch') as HTMLInputElement)?.disabled);assert.equal(await control.isChecked(),false);assert.equal(await card.locator('small').innerText(),messages['redesign.alertGuidanceNotificationsOff']);
  const before=collection(),snooze=notification();const geometry=await control.boundingBox();assert.ok(geometry);assert.equal(geometry.width,36);assert.equal(geometry.height,20);assert.ok((await card.boundingBox())!.height>=44);
  await page.getByRole('button',{name:messages['app.refreshNow'],exact:true}).focus();await page.keyboard.press('Tab');assert.equal(await control.evaluate(el=>document.activeElement===el),true);assert.equal(await control.evaluate(el=>getComputedStyle(el).outlineStyle),'solid');await page.keyboard.press('Space');await page.waitForFunction(()=>document.querySelector('.qp-alert-notifications')?.getAttribute('aria-busy')==='true');assert.equal(await control.isDisabled(),true);assert.equal(await control.isChecked(),false);assert.equal(await card.locator('small').innerText(),messages['app.loading']);assert.equal(notification().enabled,0);await page.mouse.click(geometry.x+geometry.width/2,geometry.y+geometry.height/2);assert.equal(putCount,1,'Disabled pending control must not submit a second change');put.release();
  await page.waitForFunction(()=>{const n=document.querySelector('.qp-alert-notification-switch') as HTMLInputElement;return !!n?.checked&&!n.disabled});assert.equal(notification().enabled,1);assert.equal(await card.locator('small').innerText(),messages['redesign.alertGuidanceNotificationsOn']);await control.evaluate(el=>(el as HTMLElement).blur());await card.screenshot({path:resolve(output,name+'-on.png'),animations:'disabled'});
  const motion=await control.evaluate(el=>({duration:parseFloat(getComputedStyle(el,'::before').transitionDuration)*1000,transform:getComputedStyle(el,'::before').transform}));assert.ok(reducedMotion==='reduce'?motion.duration<=1:motion.duration>=100);assert.ok(motion.transform!=='none');
  putMode='fail';await control.focus();await page.keyboard.press('Space');await page.locator('.qp-alert-error').first().waitFor();await page.waitForFunction(()=>!(document.querySelector('.qp-alert-notification-switch') as HTMLInputElement)?.disabled);assert.equal(await control.isChecked(),true);assert.equal(notification().enabled,1);
  putMode='pass';await control.focus();await page.keyboard.press('Space');await page.waitForFunction(()=>{const n=document.querySelector('.qp-alert-notification-switch') as HTMLInputElement;return !!n&&!n.checked&&!n.disabled});assert.equal(notification().enabled,0);assert.equal(await page.locator('.qp-alert-error').count(),0);
  let forcedColors=false;if(width===390&&theme==='dark'){
   await page.emulateMedia({forcedColors:'active'});assert.equal(await control.evaluate(el=>getComputedStyle(el).appearance),'auto');assert.equal(await control.evaluate(el=>getComputedStyle(el,'::before').display),'none');await control.focus();await page.keyboard.press('Space');await page.waitForFunction(()=>(document.querySelector('.qp-alert-notification-switch') as HTMLInputElement)?.checked);await control.focus();await page.keyboard.press('Space');await page.waitForFunction(()=>{const n=document.querySelector('.qp-alert-notification-switch') as HTMLInputElement;return !!n&&!n.checked&&!n.disabled});await page.emulateMedia({forcedColors:'none'});forcedColors=true;
  }
  assert.deepEqual(collection(),before,'Notification delivery must not alter sources, usage or ingest cursors');for(const key of ['snooze_until','quiet_start','quiet_end'])assert.equal(notification()[key],snooze[key]);assert.equal(await page.evaluate(()=>document.documentElement.scrollWidth>innerWidth),false);
  await page.reload();await control.waitFor();await page.waitForFunction(()=>!(document.querySelector('.qp-alert-notification-switch') as HTMLInputElement)?.disabled);assert.equal(await control.isChecked(),false);
  cases.push({name,lang,theme,width,reducedMotion,geometry,motion,initialUnknown:true,initialFailureRecovery:initialFailure,pendingDisabled:true,duplicateSuppressed:true,keyboardOnOff:true,failedUpdateRetainsConfirmedValue:true,retry:true,quietSnoozeAndCollectionPreserved:true,reloadOff:true,forcedColors});await context.close();current=undefined;
 }
 assert.equal(cases.length,32);assert.deepEqual(errors,[]);assert.deepEqual(external,[]);assert.ok(writes.every(w=>w.method==='PUT'&&w.path==='/api/notification-settings'&&Object.keys(w.body).length===1&&typeof w.body.enabled==='boolean'||w.method==='POST'&&w.path==='/api/refresh'));writeFileSync(resolve(output,'verification.json'),JSON.stringify({productionIndexSha256,cases,writes,errors,external},null,2)+'\n');console.log('PASS32 notification-switch contexts: loading/unknown, keyboard, pending/duplicate suppression, error/retry, persistence, delivery-only patch, preserved collection/quiet/snooze, reduced motion and forced colors');
}catch(error){if(current&&!current.isClosed()){await current.screenshot({path:resolve(output,'failure.png'),animations:'disabled'}).catch(()=>{});writeFileSync(resolve(output,'failure.json'),JSON.stringify({productionIndexSha256,error:String(error),url:current.url(),cases,writes},null,2)+'\n');}throw error;}
finally{await browser?.close();await app.close();db.close();}
