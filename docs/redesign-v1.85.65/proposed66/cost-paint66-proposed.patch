diff --git a/packages/web/src/redesign/cost.css b/packages/web/src/redesign/cost.css
--- a/packages/web/src/redesign/cost.css
+++ b/packages/web/src/redesign/cost.css
@@ -23,6 +23,19 @@
 .qp-cost-chart { display:flex; align-items:end; gap:4px; height:175px; padding:10px 0; border-bottom:1px solid var(--qp-border); }
 .qp-cost-chart>div { position:relative; flex:1; height:100%; min-width:2px; display:flex; align-items:end; }
 .qp-cost-column { display:block; width:100%; border-radius:3px 3px 0 0; background:linear-gradient(#2bb8ef,#4c6df2); }
+
+/* Native dark reference bar paint; keep recorded heights and zero-height boxes. */
+@media(min-width:1536px) {
+  .qp-redesign[data-testid=production-cost][data-theme=dark] .qp-cost-column {
+    background:linear-gradient(180deg,#0bd3ff 0%,#09b1fb 25%,#088af1 50%,#0766d1 75%,#064eaf 100%);
+    box-shadow:
+      inset 1px 0 0 #22caff80,
+      inset -1px 0 0 #22caff80,
+      inset 0 1px 0 #8beaff80;
+    filter:drop-shadow(0 0 4px #008cff55);
+  }
+}
+
 .qp-cost-plot { --qp-cost-plot-height:175px; display:grid; grid-template-columns:54px minmax(0,1fr) 54px; gap:8px; min-width:0; }
 .qp-cost-plot .qp-cost-chart { height:var(--qp-cost-plot-height); padding:0; background-image:linear-gradient(var(--qp-border) 1px,transparent 1px); background-size:100% calc((var(--qp-cost-plot-height) - 1px)/4); }
 .qp-cost-axis { position:relative; height:calc(var(--qp-cost-plot-height) - 1px); color:var(--qp-accent); font-size:10px; line-height:1.3; }
