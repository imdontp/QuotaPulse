{
  "name": "@quotapulse/tray",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.preload.json",
    "package": "npm test && tsx scripts/package-assets.ts",
    "start": "npm run build && electron dist/main.js",
    "icon-preview": "tsx src/preview-icons.ts",
    "test": "tsx --test test/*.test.ts",
    "validate-assets": "tsx scripts/validate-pet-assets.ts",
    "preview-tooltip": "tsx src/preview-tooltip.ts",
    "preview-pet": "tsx src/preview-pet.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^44.1.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
